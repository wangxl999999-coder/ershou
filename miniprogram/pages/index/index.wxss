.container {
  padding: 0;
  min-height: 100vh;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  margin: 20rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx 20rpx;
}

.category-list {
  display: flex;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  padding: 16rpx 8rpx;
}

.category-item.active {
  border-bottom: 4rpx solid #ff6b35;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

.category-item.active .category-name {
  color: #ff6b35;
  font-weight: bold;
}

.filter-bar {
  display: flex;
  background-color: white;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
}

.filter-item.active {
  color: #ff6b35;
  font-weight: bold;
}

.sort-icon {
  margin-left: 4rpx;
  font-size: 24rpx;
}

.filter-icon {
  margin-left: 4rpx;
  font-size: 20rpx;
}

.product-list {
  padding: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-state {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: #999;
}

.price-filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: none;
}

.price-filter-modal.show {
  display: block;
}

.filter-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
}

.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
}

.filter-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.price-inputs {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.price-input {
  flex: 1;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.price-separator {
  margin: 0 20rpx;
  font-size: 32rpx;
  color: #999;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
}

.reset-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  border: none;
}

.confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #ff6b35;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: white;
  border: none;
}
