<view class="container">
  <view class="avatar-section">
    <image class="avatar" src="{{user.avatar}}" mode="aspectFill"></image>
    <text class="avatar-tip">点击更换头像</text>
  </view>

  <view class="form-section">
    <view class="form-item" bindtap="editNickname">
      <text class="form-label">昵称</text>
      <view class="form-value">
        <text class="value-text">{{user.nickname}}</text>
        <text class="value-arrow">›</text>
      </view>
    </view>
    <view class="form-item" bindtap="editPhone">
      <text class="form-label">手机号</text>
      <view class="form-value">
        <text class="value-text">{{user.phone}}</text>
        <text class="value-arrow">›</text>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">注册时间</text>
      <view class="form-value">
        <text class="value-text text-secondary">2024-01-01</text>
      </view>
    </view>
  </view>

  <view class="stats-section">
    <view class="stats-title">我的数据</view>
    <view class="stats-grid">
      <view class="stats-item">
        <text class="stats-value">{{user.publishCount || 0}}</text>
        <text class="stats-label">发布商品</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">{{user.soldCount || 0}}</text>
        <text class="stats-label">已卖出</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">{{user.buyCount || 0}}</text>
        <text class="stats-label">已购买</text>
      </view>
    </view>
  </view>
</view>
