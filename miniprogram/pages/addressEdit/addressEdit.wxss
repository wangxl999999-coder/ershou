.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.form-section {
  background-color: white;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value .placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.default-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.default-label {
  font-size: 28rpx;
  color: #333;
}

.submit-section {
  padding: 0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ff6b35;
  color: white;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}
