<view class="container">
  <view class="tab-bar">
    <view class="tab-item {{currentType === 'buy' ? 'active' : ''}}" bindtap="switchType" data-type="buy">
      <text>我买到的</text>
    </view>
    <view class="tab-item {{currentType === 'sell' ? 'active' : ''}}" bindtap="switchType" data-type="sell">
      <text>我卖出的</text>
    </view>
  </view>

  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="id" bindtap="goOrderDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-id">订单号: {{item.id}}</text>
        <text class="order-status {{item.status === 3 ? 'completed' : ''}}">{{item.statusText}}</text>
      </view>
      <view class="order-product">
        <image class="product-image" src="{{item.product.images[0]}}" mode="aspectFill"></image>
        <view class="product-info">
          <view class="product-title ellipsis-2">{{item.product.title}}</view>
          <view class="product-price">¥{{item.price}}</view>
        </view>
      </view>
      <view class="order-footer">
        <text class="order-time">{{item.createTime}}</text>
        <view class="order-actions" wx:if="{{currentType === 'buy'}}">
          <button class="action-btn" wx:if="{{item.status === 2}}" bindtap="confirmReceive" data-id="{{item.id}}">确认收货</button>
          <button class="action-btn contact-btn" wx:if="{{item.status !== 3}}" bindtap="goChat" catchtap="true" data-id="{{item.id}}">联系卖家</button>
        </view>
        <view class="order-actions" wx:if="{{currentType === 'sell'}}">
          <button class="action-btn" wx:if="{{item.status === 1}}" bindtap="goShip" catchtap="true" data-id="{{item.id}}">去发货</button>
          <button class="action-btn contact-btn" wx:if="{{item.status !== 3}}" bindtap="goChat" catchtap="true" data-id="{{item.id}}">联系买家</button>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">暂无订单</text>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
