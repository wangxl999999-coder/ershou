.container {
  padding-bottom: 120rpx;
}

.image-swiper {
  width: 100%;
  height: 500rpx;
  background-color: #f5f5f5;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.product-info {
  background-color: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: bold;
}

.price-value {
  font-size: 48rpx;
  color: #ff6b35;
  font-weight: bold;
  margin-right: 16rpx;
}

.price-original {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

.product-title {
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.product-stats {
  display: flex;
  gap: 30rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

.seller-card {
  background-color: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.seller-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.seller-info {
  flex: 1;
}

.seller-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.seller-location {
  font-size: 24rpx;
  color: #999;
}

.chat-btn {
  padding: 12rpx 24rpx;
  background-color: #fff5f0;
  color: #ff6b35;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.description-card {
  background-color: white;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.description-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
}

.contact-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #fff5f0;
  color: #ff6b35;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  margin-right: 8rpx;
}

.buy-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ff6b35;
  color: white;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.loading {
  text-align: center;
  padding: 100rpx;
  font-size: 28rpx;
  color: #999;
}

.address-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: none;
}

.address-modal.show {
  display: block;
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background-color: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.address-list {
  max-height: 400rpx;
  overflow-y: auto;
  margin-bottom: 30rpx;
}

.address-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.address-radio {
  font-size: 32rpx;
  color: #ff6b35;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.address-info {
  flex: 1;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.address-phone {
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
}

.address-default {
  padding: 4rpx 12rpx;
  background-color: #fff5f0;
  color: #ff6b35;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.add-address-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
  margin-bottom: 20rpx;
}

.confirm-buy-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ff6b35;
  color: white;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}
