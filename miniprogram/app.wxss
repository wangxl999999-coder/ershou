page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 20rpx;
}

.btn-primary {
  background-color: #ff6b35;
  color: white;
  border-radius: 8rpx;
  border: none;
}

.btn-primary:active {
  background-color: #e55a2b;
}

.btn-default {
  background-color: white;
  color: #333;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.text-primary {
  color: #ff6b35;
}

.text-secondary {
  color: #999;
}

.text-danger {
  color: #f44336;
}

.card {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
